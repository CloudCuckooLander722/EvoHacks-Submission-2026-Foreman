# --- Jev (TypeSafe) via Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev
JEV_MAX_CONCURRENCY=32
JEV_MAX_RPS=60
JEV_MAX_STATE_TOKENS=28000
JEV_TIMEOUT_S=20
JEV_PRICE_PER_M_INPUT=0.042

# --- Light LLM: DeepSeek V4 Flash on Fireworks (fallback, proposals, planner) ---
FIREWORKS_API_KEY=
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash
LLM_MAX_CONCURRENCY=8
# SDK client default; the per-call timeouts below override it
LLM_TIMEOUT_S=30
# decide() fallback: give up after this (no retry) and keep Jev's answer as low_confidence
LLM_DECIDE_TIMEOUT_S=8
LLM_JSON_TIMEOUT_S=90
LLM_DECIDE_MAX_TOKENS=256
LLM_JSON_MAX_TOKENS=4096
# DeepSeek V4 reasons by default (~4k hidden tokens, ~40 s per call); "none" turns it off.
# "low" is ignored by the model. Leave empty to not send the parameter.
LLM_REASONING_EFFORT=none
# Fill in from Fireworks pricing so cost meters are accurate (USD per 1M tokens)
LLM_PRICE_PER_M_INPUT=0
LLM_PRICE_PER_M_OUTPUT=0

# --- Run defaults ---
CONFIDENCE_THRESHOLD=0.7
RUNS_DIR=runs
LOG_LEVEL=INFO

# --- Chat UI (my-adk-agent/web/chat_interface.py) ---
# Password every visitor must type before chatting. Required for live (non-fake) chat.
CHAT_ACCESS_KEY=
# 1 = chat with FakeLLM offline (no Fireworks key needed)
CHAT_FAKE=0
