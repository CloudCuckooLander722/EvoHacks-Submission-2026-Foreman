# --- Jev (TypeSafe) via Vercel AI Gateway ---
AI_GATEWAY_API_KEY=
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev
JEV_MAX_CONCURRENCY=32
JEV_MAX_RPS=60
JEV_MAX_STATE_TOKENS=28000
JEV_TIMEOUT_S=20
JEV_PRICE_PER_M_INPUT=0.042

# --- Light LLM: DeepSeek V4 Flash on Fireworks (fallback, proposals, planner) ---
FIREWORKS_API_KEY=
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash
LLM_MAX_CONCURRENCY=8
LLM_TIMEOUT_S=30
# Fill in from Fireworks pricing so cost meters are accurate (USD per 1M tokens)
LLM_PRICE_PER_M_INPUT=0
LLM_PRICE_PER_M_OUTPUT=0

# --- Run defaults ---
CONFIDENCE_THRESHOLD=0.7
RUNS_DIR=runs
LOG_LEVEL=INFO
